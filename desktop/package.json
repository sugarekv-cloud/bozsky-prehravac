{
  "name": "bozsky-prehravac-desktop",
  "productName": "Božský přehrávač",
  "version": "2.0.0-alpha.1",
  "description": "Samostatný filmový katalog pro Webshare a filmová metadata",
  "author": "Božský přehrávač Community",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win nsis portable --x64",
    "package:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^36.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cz.bozskyprehravac.desktop",
    "productName": "Božský přehrávač",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
